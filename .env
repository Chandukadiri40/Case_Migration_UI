# Set this to your backend base URL.
# If frontend and backend run on the same host, leave it blank and use the vite proxy instead.
VITE_API_BASE_URL=http://localhost:8080/api

# Target Server Environment Label
VITE_SERVER_ENV_NAME=Ubuntu Server 24.04 LTS (192.168.1.102)

# Remote Ubuntu Server SSH Connection Details
VITE_SSH_HOST=192.168.1.102
VITE_SSH_USER=skts
VITE_SSH_PASS=Skts@123

# Executable & Script Paths on Server
VITE_CASE_INGESTION_JAR_PATH="/home/skts/IS Migration/Migration_Tools/CaseMigration/caseingestion-0.0.1.jar"
VITE_FILENET_MIGRATOR_CMD=dotnet TrueMigrator.dll
VITE_IS_EXTRACTION_SCRIPT=python3 /opt/truemigrate/scripts/extract_is_docs.py

# Server Output Log Directory
VITE_LOG_DIRECTORY_PATH=/var/log/truemigrate

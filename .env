# =================================================================
# TRUEMIGRATOR CONFIGURATION (.env)
# Configure your network IPs, hosts, database and server parameters here.
# Any changes made here are reflected throughout the entire application.
# =================================================================

# API Base URL (Relative /api ensures it works seamlessly behind Vite proxy or Nginx)
VITE_API_BASE_URL=/api

# Remote Linux Server & SSH Connection Details
VITE_SSH_HOST=172.31.214.53
VITE_SSH_PORT=22
VITE_SSH_USER=skts
VITE_SSH_PASS=Skts@123
VITE_SERVER_ENV_NAME=RHEL Server

# Remote Directory Paths & Executables
VITE_STORAGE_MOUNT_PATH=/home/skts/IS Migration
VITE_DOCUMENTS_PATH=/home/skts/IS Migration
VITE_CASE_MIGRATION_DIR=/home/skts/IS Migration/Migration_Tools/CaseMigration
VITE_IS_MIGRATION_DIR=/home/skts/IS Migration/Migration_Tools/TrueMigrator
VITE_CASE_IMPORT_JAR_PATH=/home/skts/IS Migration/Migration_Tools/CaseMigration/CaseImport/case-import-0.0.1.jar
VITE_FILENET_MIGRATOR_CMD=dotnet TrueMigrator.dll
VITE_IS_EXTRACTION_SCRIPT=python3 /opt/truemigrate/scripts/extract_is_docs.py
VITE_CASE_EXTRACTION_JAR_PATH=/home/skts/IS Migration/Migration_Tools/CaseMigration/CaseExtraction/case-extraction-0.0.1.jar
VITE_CASE_TRANSFORMATION_JAR_PATH=/home/skts/IS Migration/Migration_Tools/CaseMigration/CaseTransformation/case-transformation-0.0.1.jar
VITE_LOG_DIRECTORY_PATH=/var/log/truemigrate

# Source Configuration (FileNet Image Services)
VITE_SOURCE_SYSTEM=FileNet Image Services
VITE_SOURCE_HOST=FNIS
VITE_SOURCE_LIBRARY_NAME=FNIS
VITE_SOURCE_USERNAME=SysAdmin
VITE_SOURCE_PASSWORD=SysAdmin
VITE_SOURCE_CONN_STRING=
VITE_SOURCE_DESCRIPTION=

# Offline Extraction Settings & Paths
VITE_OFFLINE_INDEX_DB_TABLE=DOCTABA_STAGING_TABLE
VITE_OFFLINE_MKF_EXPORT_PATH=/mnt/truemigrate/staging/mkf db
VITE_OFFLINE_MSAR_DAT_PATH=/mnt/truemigrate/staging/msar-dat
VITE_OFFLINE_FILE_PATTERN=*.dat

# Custom Tables
VITE_CUSTOM_CASE_TABLE=CLAIMS_CASE_METADATA
VITE_CUSTOM_DOCTABA_TABLE=DOCTABA_STAGING_TABLE

# Migration Database (RDBMS Staging) Configuration
VITE_DB_HOST=SKTS-LPTP-IN03
VITE_DB_PORT=5432
VITE_DB_NAME=migration_db
VITE_DB_USER=postgres
VITE_DB_PASS=password
VITE_DB_TYPE=postgres

# Target Configuration (IBM FileNet P8 / BAW)
VITE_TARGET_SYSTEM=FileNet P8
VITE_TARGET_HOST=bawvm.skts.com
VITE_TARGET_PORT=9443
VITE_TARGET_PROTOCOL=https
VITE_TARGET_USERNAME=p8admin
VITE_TARGET_PASSWORD=Skts@123
VITE_TARGET_OBJECT_STORE=FNOS
VITE_TARGET_TIMEOUT=30
VITE_TARGET_BATCH_IMPORT=yes
VITE_TARGET_DESCRIPTION=

# Staging Storage (NAS/SAN)
VITE_STORAGE_TYPE=NAS
VITE_STORAGE_PROTOCOL=NFS
VITE_STORAGE_HOST=TM-Migration
VITE_STORAGE_CAPACITY=2048
VITE_STORAGE_THRESHOLD=85
